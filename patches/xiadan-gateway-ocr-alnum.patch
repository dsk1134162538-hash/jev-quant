diff --git a/tests/test_ocr_alnum.py b/tests/test_ocr_alnum.py
new file mode 100644
index 0000000..54d6b97
--- /dev/null
+++ b/tests/test_ocr_alnum.py
@@ -0,0 +1,82 @@
+"""OCR 字母数字契约测试（patches/xiadan-gateway-ocr-alnum.patch 引入）
+
+护栏：
+- recognize() 必须返回 4 位字母数字或空串（不再是"仅数字"）
+- ddddocr 默认打开，case_mode 三档（as_is/upper/lower）都要能生效
+- 存档里的历史失败样本（含字母混合）应识别为 4 位字母数字
+
+数据依赖 assets/captcha_archive/failed_1790744779307.png（含字母的历史样本），
+不存在则跳过该用例，其他单元测试仍跑。
+"""
+import os
+
+import pytest
+
+from src.core.ocr import OcrService, _keep_alnum
+
+
+_ARCHIVE = os.path.join(os.path.dirname(__file__), "..", "assets", "captcha_archive")
+_LETTERED_SAMPLE = os.path.abspath(os.path.join(_ARCHIVE, "failed_1790744779307.png"))
+
+
+def test_keep_alnum_drops_noise():
+    assert _keep_alnum(" S m k f\n") == "Smkf"
+    assert _keep_alnum("") == ""
+    assert _keep_alnum(None) == ""
+    assert _keep_alnum("12ab!@#$") == "12ab"
+
+
+def _fresh_ocr() -> OcrService:
+    OcrService._reset_instance()
+    return OcrService.get_instance()
+
+
+def test_configure_defaults_enable_ddddocr():
+    ocr = _fresh_ocr()
+    assert ocr._ddddocr_enabled is True
+    assert ocr._case_mode == "as_is"
+
+
+def test_configure_rejects_unknown_case_mode():
+    ocr = _fresh_ocr()
+    ocr.configure(ddddocr_enabled=True, case_mode="typo")
+    assert ocr._case_mode == "as_is"
+
+
+def test_apply_case_branches():
+    ocr = _fresh_ocr()
+    ocr._case_mode = "as_is"
+    assert ocr._apply_case("SmKf") == "SmKf"
+    ocr._case_mode = "upper"
+    assert ocr._apply_case("SmKf") == "SMKF"
+    ocr._case_mode = "lower"
+    assert ocr._apply_case("SmKf") == "smkf"
+
+
+@pytest.mark.skipif(not os.path.exists(_LETTERED_SAMPLE),
+                    reason="没有历史字母样本存档；跑过一次真实弹窗后会有")
+def test_recognize_returns_4_alnum_on_lettered_sample():
+    """字母混合验证码必须识别为 4 位字母数字（回归保护）"""
+    ocr = _fresh_ocr()
+    ocr.configure(ddddocr_enabled=True, case_mode="as_is")
+    ok = ocr.warmup()
+    if not ocr._ddddocr_loaded:
+        pytest.skip("ddddocr 未装（pip install ddddocr 或 uv sync --extra ocr）")
+    assert ok
+
+    result = ocr.recognize(_LETTERED_SAMPLE)
+    assert len(result) == 4, f"期望 4 位字母数字，得到 {result!r}"
+    assert result.isalnum(), f"结果含非字母数字字符：{result!r}"
+    # 存档里该样本 dj 亲自记录真值为 SmKf，ddddocr 稳定给 Smkf 或近似
+    assert result.lower() == "smkf", f"识别偏离历史真值：{result!r} vs Smkf"
+
+
+@pytest.mark.skipif(not os.path.exists(_LETTERED_SAMPLE), reason="见上")
+def test_recognize_upper_mode_on_lettered_sample():
+    ocr = _fresh_ocr()
+    ocr.configure(ddddocr_enabled=True, case_mode="upper")
+    ocr.warmup()
+    if not ocr._ddddocr_loaded:
+        pytest.skip("ddddocr 未装")
+    result = ocr.recognize(_LETTERED_SAMPLE)
+    assert result == result.upper() and len(result) == 4
